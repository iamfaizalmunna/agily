generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  sessions     Session[]
  memberships  TeamMember[]
  assignments  ItemAssignee[]
  lenses       FilterLens[]
  updates      ItemUpdate[]
  itemEvents     ItemEvent[]
  notices        Notification[]
  securityEvents SecurityEvent[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  settings  String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  invites   Invite[]
  projects  Project[]
  lenses    FilterLens[]
  notices   Notification[]
  labels         Label[]
  securityEvents SecurityEvent[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Invite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  token     String   @unique
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  slug        String
  workflow    String   @default("")
  fieldSchema String   @default("[]")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groups    Group[]
  items        Item[]
  dependencies ItemDependency[]

  @@unique([teamId, slug])
}

model Group {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     Item[]
}

model Item {
  id        String    @id @default(cuid())
  projectId String
  groupId   String
  parentId  String?
  title     String
  body      String    @default("")
  type      String    @default("task")
  priority  String    @default("minor")
  storyPoints   Int?
  status        String
  customFields  String    @default("{}")
  dueOn         DateTime?
  position      Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group      Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent     Item?          @relation("ItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Item[]         @relation("ItemTree")
  assignees  ItemAssignee[]
  updates    ItemUpdate[]
  labels     ItemLabel[]
  subtasks   Subtask[]
  events            ItemEvent[]
  blocksOthers      ItemDependency[] @relation("DepSuccessor")
  blockedBy         ItemDependency[] @relation("DepPredecessor")

  @@index([parentId])
}

model ItemDependency {
  id            String  @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor   Item    @relation("DepPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Item    @relation("DepSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([projectId])
}

model Subtask {
  id       String  @id @default(cuid())
  itemId   String
  title    String
  done     Boolean @default(false)
  position Int
  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Label {
  id     String      @id @default(cuid())
  teamId String
  name   String
  color  String
  team   Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  items  ItemLabel[]

  @@unique([teamId, name])
}

model ItemLabel {
  id      String @id @default(cuid())
  itemId  String
  labelId String
  item    Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([itemId, labelId])
}

model ItemAssignee {
  id     String @id @default(cuid())
  itemId String
  userId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

model FilterLens {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  name      String
  spec      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, name])
}

model ItemUpdate {
  id        String       @id @default(cuid())
  itemId    String
  userId    String
  body      String
  parentId  String?
  createdAt DateTime     @default(now())
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    ItemUpdate?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ItemUpdate[] @relation("CommentReplies")

  @@index([parentId])
}

model ItemEvent {
  id        String   @id @default(cuid())
  itemId    String
  userId    String?
  kind      String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  kind        String
  actorUserId String?
  teamId      String?
  meta        String   @default("{}")
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  kind      String
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
