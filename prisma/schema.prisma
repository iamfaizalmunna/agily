generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  sessions     Session[]
  memberships  TeamMember[]
  assignments  ItemAssignee[]
  lenses       FilterLens[]
  updates      ItemUpdate[]
  notices      Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  settings  String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  invites   Invite[]
  projects  Project[]
  lenses    FilterLens[]
  notices   Notification[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Invite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  token     String   @unique
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Project {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  slug      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groups    Group[]
  items     Item[]

  @@unique([teamId, slug])
}

model Group {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     Item[]
}

model Item {
  id        String    @id @default(cuid())
  projectId String
  groupId   String
  title     String
  body      String    @default("")
  priority  String    @default("minor")
  status    String
  dueOn     DateTime?
  position  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group      Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignees  ItemAssignee[]
  updates    ItemUpdate[]
}

model ItemAssignee {
  id     String @id @default(cuid())
  itemId String
  userId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

model FilterLens {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  name      String
  spec      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, name])
}

model ItemUpdate {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  kind      String
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
