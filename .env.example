# Database (SQLite path relative to prisma/ unless absolute file: URL)
DATABASE_URL="file:./prisma/dev.db"

# Required: long random string (32+ chars in production)
SESSION_SECRET="replace-with-a-long-random-string"

# Optional session lifetime (days; max 90 in production)
# SESSION_DAYS="14"

# Public site URL (production Origin checks / invites)
# APP_URL="https://agily.example.com"

# Demo logins on /signin (never true in production)
NEXT_PUBLIC_DEMO_MODE="false"
# DEMO_MODE="false"

# Ollama (loopback only)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# Lens sidecar (loopback; Next rewrites /lens-api → LENS_API_URL)
LENS_API_URL="http://127.0.0.1:43124"
LENS_API_PORT="43124"
# LENS_KB_DIR="./kb"
# LENS_KB_HTTP="false"
# LENS_CORS_ORIGINS=""

# CSP: set true to enforce CSP in local dev
# SECURITY_CSP_ENFORCE="false"
