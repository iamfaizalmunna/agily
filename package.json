{
  "name": "agily",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev -H 127.0.0.1 -p 43123\" \"npm run dev -w @agily/api\"",
    "dev:demo": "NEXT_PUBLIC_DEMO_MODE=true npm run dev",
    "dev:web": "next dev -H 127.0.0.1 -p 43123",
    "dev:api": "npm run dev -w @agily/api",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 43123",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "tsx --test \"src/**/*.test.ts\" \"packages/lens/src/**/*.test.ts\"",
    "test:coverage": "c8 tsx --test \"src/**/*.test.ts\" \"packages/lens/src/**/*.test.ts\"",
    "sonar": "npm run test:coverage && sonar-scanner",
    "db:e2e": "DATABASE_URL=file:./prisma/e2e.db npx prisma migrate deploy && DATABASE_URL=file:./prisma/e2e.db npx prisma db seed",
    "test:e2e": "lsof -tiTCP:43123 -sTCP:LISTEN | xargs kill -9 2>/dev/null; lsof -tiTCP:43124 -sTCP:LISTEN | xargs kill -9 2>/dev/null; npm run db:e2e && CI=true DATABASE_URL=file:./prisma/e2e.db playwright test",
    "test:e2e:ui": "npm run db:e2e && DATABASE_URL=file:./prisma/e2e.db playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "frappe-gantt": "^1.2.2",
    "gantt-task-react": "^0.3.9",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^12.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turbo": "^2.5.8",
    "typescript": "^5"
  }
}
