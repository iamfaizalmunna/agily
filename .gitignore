# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
/prisma/e2e.db
/prisma/e2e.db-journal

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit .env.example only)
.env
.env.local
.env*.local
!.env.example

# user uploads (avatars)
/data/

# local databases and model weights (never GitHub)
*.db
*.db-journal
*.db-shm
*.db-wal
*.gguf
.ollama/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
